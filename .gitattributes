# -----------------------------------------------------------------------------
# .asset files Unity ALWAYS writes as binary, even with Force Text (terrain
# heightmaps, baked lighting, baked NavMesh). Matched by Unity's default names,
# because most other .asset files are small YAML that should stay mergeable.
# If you rename a terrain asset, keep "Terrain" in the name or add a rule here.
# -----------------------------------------------------------------------------
TerrainData*.asset             filter=lfs diff=lfs merge=lfs -text
Terrain_*.asset                filter=lfs diff=lfs merge=lfs -text
New[[:space:]]Terrain*.asset   filter=lfs diff=lfs merge=lfs -text
LightingData.asset             filter=lfs diff=lfs merge=lfs -text
NavMesh-*.asset                filter=lfs diff=lfs merge=lfs -text
